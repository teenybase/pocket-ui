{
  "name": "@teenybase/pocket-ui",
  "version": "0.0.3",
  "description": "Pocket UI for teenybase admin. (forked from pocketbase)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "npm run build",
    "run-pack": "npm pack",
    "run-publish": "git diff --exit-code --name-only master * && npm publish --access public && git tag v$npm_package_version && git push --tags"
  },
