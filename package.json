  "license": "Apache-2.0",
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@types/node": "^22.10.1",
    "sass": "^1.45.0",
    "svelte": "^4.0.0",
    "svelte-spa-router": "^4.0.1",
    "teenybase": "^0.0.2",
    "typescript": "^5.7.2",
    "vite": "^5.0.11",
    "luxon": "^3.5.0",
    "svelte-flatpickr": "^3.3.5",
